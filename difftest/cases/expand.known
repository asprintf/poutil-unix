# the obsolete -4 form: no longer in the synopsis (macOS and GNU still take it)
-4 plain
# tablists the text does not allow (an empty item, a sign): GNU is lenient
-t ,3 plain
-t "" plain
-t "3, 6" plain
-t +3 plain
-t 3, plain
-t 3,,6 plain
# repeated -t: here the last one wins (as on macOS); GNU joins the lists
-t 4 -t 8 plain
-t 8 -t 4 plain
# width of control characters is not specified: here ASCII controls take no
# column; GNU counts one
ctl
-t 4 ctl
# "-" is standard input (PCTS 833); macOS opens a file named "-"
-t 4 plain -
# macOS counts the bytes of non-ASCII text in the C locale as no column and
# stops on an invalid sequence in UTF-8
mb
-t 4 mb
-t 3,10 mb
comb
bad
latin1
# the column carries over from one file to the next (as in GNU); macOS
# begins every file at column 0
nonl1 nonl2
# expand terminates at the first file operand it cannot access (CONSEQUENCES
# OF ERRORS of expand, PCTS 824; unexpand has the default and goes on).
# macOS does the same; GNU goes on with the next operand
dir plain
noread plain
nosuch plain
plain nosuch many

# --- cases added later: every line below differs from both macOS and GNU
# bytes that are not characters and control characters (their width is not specified)
-t 3,10 t.all256_lines
-t 3,10 w.all256_lines
-t 4 t.all256_lines
-t 4 w.all256_lines
all256_lines
in:t.all256_lines
in:t.all256_lines -
in:t.all256_lines -t 3,10 -
in:t.all256_lines -t 4
in:w.all256_lines
in:w.all256_lines -
in:w.all256_lines -t 3,10 -
in:w.all256_lines -t 4
t.all256_lines
w.all256_lines
