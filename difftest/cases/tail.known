# the obsolete -number and +number forms were dropped in POSIX.1-2001 ("+" may
# be taken as an option delimiter, it need not be); GNU and macOS still take them
-3 n5
+3 n5
# the synopsis takes at most one file; both others accept several and print headers
-n 2 n5 n30
# the last of -c and -n wins here; macOS refuses to have both or either twice
-c 4 -n 3 n30
-n 3 -c 4 n30
-n 3 -n 2 n30
# macOS rejects a count that does not fit; for us (and GNU) it just means "all"
-c 99999999999999999999999 n5
-n +99999999999999999999999 n5
-n 99999999999999999999999 n5
# macOS tail does not treat "-" as standard input (the spec allows either)
-c 3 -
-n 2 -
-n +2 -
# macOS reads a directory without complaint; we report the read error
-n 2 d

# --- cases added later: every line below differs from both macOS and GNU
# the obsolete -number and +number forms and long options: both others take them
+0 ten
+2c ten
+2l ten
+3 ten
+33 ten
--bytes=2 ten
--lines=2 ten
-0 ten
-2c ten
-2l ten
-3 ten
-33 ten

# size suffixes (k b K M) on a count: both others take them
-c 1K ten
-c 1M ten
-c 3b ten
-n 3k ten

# -q -v and several files: the synopsis has one file; both others take more and print headers
-- -n ten
-n 2 d ten
-n 2 nosuch ten
-n 2 ten ''
-n 2 ten eleven
-n 2 ten nosuch
-n 2 ten ten
-q ten
-v ten

# the spec wants digits only: a blank in a count; both others accept it
-c ' 1' ten
-n ' 1' ten

# options after an operand: both others take them as options, POSIX08 reads them as operands
-n 1 ten -n 2
ten -n 2

# a repeated -n after another option: both others take the last
-n +2 -n 3 ten
