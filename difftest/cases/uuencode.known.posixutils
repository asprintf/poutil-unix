# Base64 lines of 60 characters (the text allows up to 76; macOS writes 76)
-m text name
-m -- text name
-m mode600 n
-m bytes n
-m x56 n
-m x57 n
-m x58 n
-m x59 n
-m x60 n
-m x90 n
-m x91 n
-m x114 n
-m x115 n
-m x300 n
-m text /dev/stdout
# after the first operand "-m" and "--" are operands (PCTS 29)
-m text -m
-m -m name
text -m
text --
text -m-
text name -m
# the begin line is written before the input turns out to be unreadable
dir n
