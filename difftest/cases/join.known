# -j, -j1, -j2 were removed in Issue 6 (CHANGE HISTORY); macOS and GNU still take them
-j 1 f1 f2
-j1 1 f1 f2
-j2 1 f1 f2
# the -t character is "char": an empty string is none (macOS and GNU accept it)
-t '' f1 f2
# -e is "in the list selected by -o" and RATIONALE says it is only effective with -o; macOS and GNU also replace the empty fields of the default output
-e bozo -t : c1 c2
-t : -e X c1 c2
# the synopsis is [-a file_number|-v file_number]: both together is a usage error (GNU accepts it)
-a 1 -v 2 f1 f2
-v 1 -a 1 f1 f2
# the -o list is commas or blanks, elements are 0 or file_number.field with file_number 1 or 2; the spec says nothing of an empty element, a mixture or file 0, so those are usage errors here (the references accept some of them)
-o 1.1, f1 f2
-o ,1.1 f1 f2
-o '1.1, 2.1' f1 f2
-o 1.1,,2.1 f1 f2
-o ''  f1 f2
-o 0.1 f1 f2
# GNU wants a single blank between the elements of a blank-separated list; "blank-separated" allows runs, as macOS does
-o '0  1.2   2.2' f1 f2
-o ' 0 1.2 ' f1 f2
# both operands - (the standard input twice): the spec is silent, the references refuse; the second read is an end of file here
- -
# GNU takes an option that follows an operand; POSIX08 treats it as an operand (PCTS join 47)
f1 f2 -a 1
f1 -a 1 f2
# repeated options are read in order (XBD guideline 11), the last one wins; GNU refuses a repeat that conflicts
-1 5 -1 1 f1 f2
-2 5 -2 1 f1 f2
-e a -e b -o 1.9 f1 f2
-t : -t ';' semi1 semi2
# input that is not sorted for the -t field: the results are unspecified; GNU reports the disorder and fails
-t : sp1 sp2
-t ' ' sp1 sp2
-t "	" sp1 sp2
# bytes that are not characters in en_US.UTF-8: unspecified
bin1 bin2
-a 1 -a 2 bin1 bin2
# macOS reads a line only up to a NUL
nul1 nul2
# a line that has no join field has an empty one: macOS sorts those lines after the others
-1 3 -a 1 -a 2 f1 f2

# --- 2026-11-06 cases: every line below differs from both macOS and GNU
# bytes that are not characters in en_US.UTF-8, and a join field the files are not sorted on: unspecified
-a 1 -a 2 -o 0,1.2,2.2 -e X invalid.1 invalid.2
-a 1 -a 2 invalid.1 invalid.2
-a 1 invalid.1 invalid.2
-a 2 -e - -o 1.1,2.1,0 invalid.1 invalid.2
-a 2 invalid.1 invalid.2
-o 0,1.2,2.2 invalid.1 invalid.2
-t '	' -1 2 -2 3 -a 1 -a 2 tsv.1 tsv.2
-t '	' -1 3 -2 3 -a 1 -a 2 -o 0,1.1,2.1 tsv.1 tsv.2
-v 1 -o 0,1.2 invalid.1 invalid.2
-v 1 -v 2 invalid.1 invalid.2
-v 1 invalid.1 invalid.2
-v 2 invalid.1 invalid.2
invalid.1 invalid.2
