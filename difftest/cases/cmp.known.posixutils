# -l lists only the first difference there, and writes no EOF message
-l a many
-l many many2
-l many2 many
-l bin1 bin2
-l crlf lf
-l sp1 sp2
-l - a
-l a -
# repeated options are an error there (clap)
-l -l a b
-ll a b
-ss a b
# an argument that starts with - after an operand is an option there
a -l
-s -s a b
# -s with an error: silent there
-s a dir
