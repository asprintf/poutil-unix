# the output without -P is unspecified; it writes a different layout, ours is the -P line
-k
-k -k
@
/
.
d
-- /
/ -k
/ -- /
-k /
-k -- -P /
# -t is not an option there
-t
-t -t
-k -t
-kt
-tk
-t /
# long options are an extension
--help
--version
-P --version
# the standard leaves a special file that is not the device of a mounted file system unspecified; macOS refuses it and so do we, it shows the /dev file system
-P /dev/null
-P /dev/null /
-P /dev/tty
-P /dev/zero
# a repeated option is an error there (clap)
-P -P
# it names the Data volume for / and files in it, takes an option after an operand (PCTS df 836: it is an operand), and writes the -P header even when no operand could be shown (the standard says nothing for that case; macOS and GNU write none)
-P . .
-P f d p
-P /
-kP /
-P //
-P / /dev
-P /dev /
-P / /
-P /nosuch
-P /nosuch /
-P / /nosuch
-P / /nosuch /dev
-P /nosuch /nosuch2
-P dangling
-P dangling /
-P f/x
-P '' /
-P -- /
-P -- -k
-- -P
-P / -k
-P / -P
-- /nosuch
