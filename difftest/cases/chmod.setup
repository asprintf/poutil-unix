/usr/bin/true
touch f0 f4 f6 f7 f77 fs fg
mkdir d0 d7 dt dg
# set-group-ID sticks only if the group of the file is one of ours (a new directory takes that of its
# parent), and a change of group clears it: so the group is set first
chgrp "$(id -g)" f0 f4 f6 f7 f77 fs fg d0 d7 dt dg
chmod 000 f0; chmod 400 f4; chmod 644 f6; chmod 755 f7; chmod 777 f77; chmod 4755 fs; chmod 2755 fg
chmod 000 d0; chmod 755 d7; chmod 1777 dt; chmod 2755 dg
ln -s f6 l; ln -s nowhere dang; ln -s d7 ld
mkdir -p tree/s tree/e
touch tree/a tree/s/b tree/e/c
ln -s ../f6 tree/lo; ln -s a tree/la; ln -s nowhere tree/dl; ln -s .. tree/s/up
ln -s tree treelink
chmod 644 tree/a tree/s/b tree/e/c f6

# the moved Rust unit tests: a hierarchy with a directory that cannot be entered, links
# inside it, and a link to a directory as an operand
mkdir -p tree2/e tree2/s tree2/s/deep
touch tree2/a tree2/s/b tree2/e/c tree2/s/deep/z
chmod 644 tree2/a tree2/s/b tree2/e/c tree2/s/deep/z
ln -s ../f6 tree2/lo; ln -s a tree2/la; ln -s nowhere tree2/dl; ln -s .. tree2/s/up
ln -s tree2 tree2link
chmod 000 tree2/e
mkdir e1 e2
touch e1/x e1/y e2/x
chmod 700 e1
printf 'x\n' > 'ü ñ 😀.txt'
chmod 640 'ü ñ 😀.txt'
mkdir 'dir 😀'
touch 'dir 😀/in'
chmod 710 'dir 😀'
