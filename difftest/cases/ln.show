find . ! -name . | sort | while IFS= read -r f; do
	if [ -L "$f" ]; then
		echo "L $f -> $(readlink "$f") ino=$(stat -f %i "$f")"
	elif [ -d "$f" ]; then
		echo "D $f $(stat -f '%Sp' "$f") ino=$(stat -f %i "$f")"
	else
		echo "F $f $(stat -f '%Sp %l %z' "$f") ino=$(stat -f %i "$f")"
	fi
done | awk '{ n = split($NF, a, "="); i = a[2]; if (!(i in m)) m[i] = ++c; $NF = "g" m[i]; print }'
