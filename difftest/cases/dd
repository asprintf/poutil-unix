# seek: the blocks of the output that are passed are kept, the rest of the file goes
if=one of=out seek=1 obs=4
if=one of=out bs=4 seek=3
if=one of=out bs=4 seek=3 conv=notrunc
if=one of=out bs=4 seek=100
if=empty of=out bs=4 seek=3
if=empty of=out bs=4 seek=100
if=empty of=out bs=4 seek=3 conv=notrunc
if=empty of=out seek=0
if=text of=new bs=5 seek=2
if=text of=out bs=5 seek=2 count=2 conv=notrunc
if=text of=out obs=5 seek=2 conv=notrunc
# notrunc: the file keeps what is past the copy
if=one of=out conv=notrunc
if=text of=out conv=notrunc
if=empty of=out conv=notrunc
if=one of=keep conv=notrunc
if=one of=keep
# sync: every short input block is padded to ibs with null bytes, with blanks beside block or unblock
if=odd ibs=3 conv=sync
if=odd ibs=4 conv=sync
if=odd bs=4 conv=sync
if=odd ibs=16 conv=sync
if=even ibs=4 conv=sync
if=odd ibs=3 obs=10 conv=sync
if=odd ibs=4 cbs=6 conv=sync,block
if=odd ibs=4 cbs=6 conv=sync,unblock
if=lines ibs=7 cbs=6 conv=sync,block
if=empty ibs=4 conv=sync
conv=sync
# swab: pairs of bytes in each input block; the last byte of an odd block stays
if=even conv=swab
if=odd conv=swab
if=odd ibs=3 conv=swab
if=odd ibs=2 conv=swab
if=odd ibs=1 conv=swab
if=bytes256 conv=swab
if=one conv=swab
if=odd bs=3 conv=swab
if=odd ibs=4 conv=swab,sync
# lcase and ucase: by the characters of the locale
if=mixed conv=lcase
if=mixed conv=ucase
if=utf8 conv=lcase
if=utf8 conv=ucase
if=bytes256 conv=ucase
if=bytes256 conv=lcase
if=utf8 ibs=3 conv=ucase
if=utf8 ibs=1 conv=lcase
if=mixed conv=lcase,swab
if=mixed conv=swab,ucase
if=mixed conv=lcase conv=ucase
if=mixed conv=lcase,ucase
# block: lines to records of cbs, cut when too long; unblock: records to lines
if=lines cbs=5 conv=block
if=lines cbs=1 conv=block
if=lines cbs=100 conv=block
if=lines ibs=3 cbs=5 conv=block
if=lines ibs=1 cbs=5 conv=block
if=text cbs=10 conv=block
if=text cbs=10 obs=7 conv=block
if=empty cbs=5 conv=block
if=one cbs=5 conv=block
if=recs cbs=8 conv=unblock
if=recs cbs=4 conv=unblock
if=recs cbs=3 conv=unblock
if=recs ibs=5 cbs=8 conv=unblock
if=recs ibs=1 cbs=8 conv=unblock
if=odd cbs=3 conv=unblock
if=odd cbs=100 conv=unblock
if=empty cbs=5 conv=unblock
