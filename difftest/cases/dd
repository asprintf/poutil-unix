# no operand: standard input to standard output, in blocks of 512, nothing changed
in:text
in:bytes256
in:big
in:empty
in:one
# if= and of=: the file named; an existing output file is cut to the length of the copy
if=text
if=text of=out
if=one of=out
if=empty of=out
if=text of=new
if=in-emoji.txt of='out 😀'
in:text of=out
# the sizes: a number, k, b, products with x; bs sets both and wins over ibs and obs
if=big ibs=1
if=big ibs=7 obs=11
if=big ibs=1k
if=big ibs=2b obs=3
if=big ibs=2x3 obs=5
if=big ibs=1kx2
if=big ibs=1x1x1
if=big obs=1000
if=big bs=100
