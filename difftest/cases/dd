if=ebcdic conv=ascii
if=text conv=ebcdic
if=text conv=ibm
if=ebcdic conv=ascii,lcase
if=text conv=ebcdic,ucase
if=ebcdic conv=ascii,ucase
if=text conv=ascii,ebcdic
if=text conv=ascii,ibm
if=text conv=ebcdic,ibm
if=text conv=ascii conv=ebcdic
if=text conv=ibm,ibm
if=bytes256 conv=ebcdic,swab
if=bytes256 conv=swab,ibm
if=bytes256 conv=ibm bs=7
