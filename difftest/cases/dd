if=ebcdicrecs cbs=4 conv=ascii
if=text cbs=10 conv=ebcdic
if=text cbs=10 conv=ibm
if=lines cbs=5 conv=ebcdic,block
if=ebcdicrecs cbs=4 conv=ascii,unblock
# conv= values that are not
conv=
conv=nosuch
conv=sync,
conv=,sync
conv=SYNC
conv=sync,nosuch
conv=noerror,sync,notrunc
if=text conv=noerror
