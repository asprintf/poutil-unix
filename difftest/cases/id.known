# -r means nothing with -G (the synopsis has no -G -r): usage error here, ignored there
-G -n -r
-Gnr
-Gr
# extensions of macOS and GNU: -a, -p, a numeric user ID as the operand, more than one
# operand, options after the operand (the standard wants options first)
-a
-p
-u 0
-u $(id -u)
0
$(id -u)
-u $(id -un) root
$(id -un) root
-u daemon -n
-u $(id -un) -n
$(id -un) -u
