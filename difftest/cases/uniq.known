# macOS prints a last line without a newline as it is; GNU and we add the newline
nonl2
# macOS compares and prints a line only up to a NUL byte
nul
-c nul
# -d with -u is a usage error here; macOS and GNU accept both
-d -u plain

# --- cases added later: every line below differs from both macOS and GNU
# extensions of both: -D -i and the long options
--count plain
--repeated plain
--skip-fields=1 plain
--unique plain
-D plain
-i plain

# obsolete -N: both take them
-1 plain
-2 plain

# -d with -u (and -c with both) is a usage error here; the references take it
-c -d -u runs.len
-cdu f.keys
-d -u runs.len
-du f.keys
-u -d runs.len
-ud f.keys

# a field count with a leading blank: the references take it, the spec wants digits only
-f ' 1' f.keys

# the input is also the output (unspecified): the references run, we refuse
plain plain
