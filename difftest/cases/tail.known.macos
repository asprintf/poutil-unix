# the last of -c and -n wins here; macOS refuses to have both or either twice
-c 3 -c 2 ten
-c 4 -n 3 ten
-n 2 -n 3 ten
-n 3 -c 4 ten
-n 3 -n +2 ten
-n 3 -n 2 ten

# macOS reads the count with strtoll (0x1 and 1e1 are 1) and refuses one that does not fit; GNU and we refuse the first two, a huge count means all
-c '+99999999999999999999' ten
-c '-9223372036854775808' ten
-c '-9223372036854775809' ten
-c '-99999999999999999999' ten
-c '0x1' ten
-c '18446744073709551616' ten
-c '1e1' ten
-c '9223372036854775808' ten
-c '99999999999999999999' ten
-n '+99999999999999999999' ten
-n '-99999999999999999999' ten
-n '0x1' ten
-n '18446744073709551616' ten
-n '1e1' ten
-n '99999999999999999999' ten

# macOS has -r; the obsolete -number form: macOS takes it after an option too
-3 ten -n 1
-r ten
