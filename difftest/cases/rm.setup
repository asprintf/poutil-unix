touch f g h ro
chmod 444 ro
mkdir -p d/s e deep/x/y/z tree/a/b tree/c rod
touch d/a d/b d/s/c deep/x/y/z/f tree/a/b/f tree/a/g tree/c/h
ln -s f lf
ln -s d ld
ln -s nowhere dang
ln -s ld lld
mkdir lockd && touch lockd/x && chmod 555 lockd
mkdir nox && touch nox/y && chmod 000 nox
chmod 555 rod
touch -- ./-r './ sp ace'
mkdir 'new
line'
touch 'new
line/in'

# the corpus in rm.in (answers for -i) and the trees the new cases need
[ -d "${CORPUS-}" ] && cp "$CORPUS"/* .
mkdir -p pt/sub && touch pt/f pt/sub/g && chmod 555 pt
mkdir -p c1/c2/c3 && touch c1/c2/c3/f
mkdir -p mix/a mix/b && touch mix/a/f mix/b/f mix/x mix/y
mkdir -p sl/in && ln -s ../d sl/in/ld && ln -s ../../f sl/in/lf
touch w1 w2 w3 w4 w5 w6 w7 w8 w9 w10
ln f hf
mkdir -p '😂dir/👨‍👩‍👧' && touch '😂dir/👨‍👩‍👧/🇩🇪' '😂'
