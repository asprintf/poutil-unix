# repeated options are an error there (clap)
-3 -3 f1 f2
# a last line without a newline: it prints the line wrongly (cherry<tab>cherry)
nonl1 f2
f1 nonl2
nonl1 nonl2
nonl1 nonl1
-12 nonl1 nonl2
# an argument that starts with - after an operand is an option there; Issue 7 and PCTS 31 make it an operand
f1 -3
-12 f1 -3
