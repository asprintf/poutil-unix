# posixutils-rs: lists with an empty element, 1-2-3 or +1 are taken, -- ends a
# list, -b with -c is taken, options after an operand are options (clap), UTF-8
# is assumed in every locale and a byte that is no character becomes U+FFFD.
-b +1 f
-b -- f
-b 1 -f 1 f
-b 1, f
-b 1,,2 f
-b 1-2-3 f
-c -3 euro
-c -3 u
-c -3 uc
-c 1 -f 1 f
-c 1 3 euro
-c 1 3 u
-c 1 3 uc
-c 1 euro
-c 1 u
-c 1 uc
-c 1,3 euro
-c 1,3 u
-c 1,3 uc
-c 1-3 euro
-c 1-3 u
-c 1-3 uc
-c 2 euro
-c 2 u
-c 2 uc
-c 2-4,1 euro
-c 2-4,1 u
-c 2-4,1 uc
-c 3 euro
-c 3 u
-c 3 uc
-c 3- euro
-c 3- u
-c 3- uc
-c 9 uc
-d : -b 1 c
-d : -c 1 c
-d € -f 1 euro
-d € -f 2 euro
-f 1 3 -d, -s c
-f 1 3 -d, -s crlf
-f 1 3 -d, -s csv
-f 1 3 -d, -s nl
-f 1 3 -d, -s sp
-f 1 3 -d, -s t
-f 1 3 -d, -s u
-f 1 3 -d, -s uc
-f 1 3 -d, csv
-f 1 3 -d, sp
-f 1 3 -d, t
-f 1 3 -d: -s c
-f 1 3 -d: -s crlf
-f 1 3 -d: -s csv
-f 1 3 -d: -s nl
-f 1 3 -d: -s sp
-f 1 3 -d: -s t
-f 1 3 -d: -s u
-f 1 3 -d: -s uc
-f 1 3 -d: c
-f 1 3 -d: sp
-f 1 3 -d: t
-f 1 3 -d: uc
-f 1 3 -s -d: c
-f 1 3 -s -d: crlf
-f 1 3 -s -d: csv
-f 1 3 -s -d: nl
-f 1 3 -s -d: sp
-f 1 3 -s -d: t
-f 1 3 -s -d: u
-f 1 3 -s -d: uc
-f 1 3 -s c
-f 1 3 -s crlf
-f 1 3 -s csv
-f 1 3 -s nl
-f 1 3 -s t
-f 1 3 -s u
-f 1 3 -s uc
-f 1,3 -d € uc
