# Sizes: a number with k, b or x products (the standard); macOS also takes m.
if=big ibs=1m
# An operand given twice: the standard leaves it open; the last one counts here (as GNU), macOS refuses.
if=lines cbs=5 cbs=3 conv=block
if=text bs=3 bs=5
if=text ibs=3 ibs=5
if=text if=bytes256
if=text of=new of=out
# ascii, ebcdic and ibm exclude each other; macOS lets the last one win.
if=text conv=ebcdic,ibm
# lcase and ucase map the characters before the conversion to EBCDIC (the order of the standard, as GNU); macOS maps after it.
if=text conv=ebcdic,ucase
