# GNU echo takes -n as an option; XSI (and so we) treat it as a string
-n a
# GNU echo also takes \e, \NNN and \xHH; XSI defines only \0num
'\e'
'\x41'
'\101'
# GNU takes -n (alone) as an option, as above; XSI has it as a string
-n
-n -n
# only \0num is defined; any other escape, \1 for one, is unspecified (GNU reads it as octal)
'\1'
