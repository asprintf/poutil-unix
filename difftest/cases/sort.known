# an empty -t: macOS takes it as no separator; GNU and we refuse it
-t '' words
# -c takes one file and cannot be combined with -m or -o (the synopsis);
# macOS looks at the first file only or ignores -o, GNU lets -m win
-c m1 m2
-c -m sorted
-c -o x sorted
# -d -f -i -n together are undefined; GNU refuses -d with -i or -n
-bdfinr words
# bytes that are no characters in a UTF-8 locale: the order is unspecified,
# macOS puts them elsewhere and GNU stops with "Illegal byte sequence"
bin
-r bin
# GNU on macOS fails in strcoll for any key made of a copy ("-d -i -k"), with
# "string comparison failed: Illegal byte sequence", even for valid text
-d utf8
-i utf8
-k 1.2 utf8
-k 1.1,1.1 utf8
# neither macOS nor GNU take a multibyte character as the separator here
-t é utf8

# --- cases added later: every line below differs from both macOS and GNU
# UTF-8: non-ASCII collates equal in macOS libc, refs keep input order; we tie-break bytewise; GNU also fails in strcoll
-b u8.spaces
-c -r u8.scripts
-c u8.scripts
-d u8.scripts
-d u8.spaces
-d u8.symbols
-f u8.combining
-f u8.invalid
-f u8.scripts
-f u8.spaces
-f u8.symbols
-fr u8.scripts
-i u8.scripts
-i u8.spaces
-i u8.symbols
-k 1,1 u8.invalid
-k 1.1,1.1 u8.invalid
-k 1.2 u8.invalid
-k 1.2 u8.symbols
-k 1.2,1.2 u8.scripts
-k 1.2,1.2 u8.symbols
-k 1.2,1.3 u8.combining
-n u8.invalid
-n u8.symbols
-r u8.invalid
-r u8.scripts
-r u8.spaces
-u u8.invalid
in:u8.invalid
in:u8.invalid -C
u8.combining
u8.invalid
u8.scripts
u8.spaces
u8.symbols

# extensions (-g -h -M -R -s -S -T -V -z), refused on purpose
-g nums
-h nums
-M words
-R words
-S 1M words
-s words
-T /tmp words
-V words
-z words

# a multibyte -t is taken here, both references refuse it
-t é words

