# the synopsis requires a dir operand; posixutils-rs exits 0 without one, we and macOS report a usage error
@
-m 700
# an empty mode is not valid (chmod mode grammar); posixutils-rs accepts it and creates the directory with the default mode, we and macOS reject it
-m '' d1
# an empty pathname names nothing; posixutils-rs exits 0, we and macOS fail with No such file or directory
-p ''
# posixutils-rs refuses a repeated option (clap: cannot be used multiple times); we, macOS and GNU accept it
-m 700 -m 755 d1
-pp d1
