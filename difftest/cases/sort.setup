printf 'b\na\nc\nB\nA\na\n' > words
printf 'x 3 b\ny 1 c\nz 2 a\nw 10 d\nv 2 e\n' > fields
printf 'b|3|x\na|10|y\nc|2|z\nd||w\ne|2\n' > pipes
printf '10\n9\n100\n1\n-5\n-10\n0\n+3\n  7\n2.5\n2.25\n.5\n-.5\nabc\n1e3\n007\n-0\n' > nums
printf '1,000\n999\n1,5\n1.5\n12,345.6\n' > thou
printf 'a-c\nab\na b\nab-\nA B\n' > dict
printf 'a\001c\nab\na\002b\nAb\n' > nonprint
printf 'apple\nBanana\ncherry\nApple\nbanana\nCherry\n' > mixed
printf 'a  z\nb y\nc   x\n d w\n' > blanks
printf 'a\ta\nb a\nc\tb\n' > tabs
printf 'x 1\nx 1\ny 2\nx 1\n' > dups
printf 'b 2\na 2\nb 1\na 1\n' > two
printf 'a\nc\ne\n' > m1
printf 'b\nd\nf\n' > m2
printf 'a\nb\nb\nc\n' > s1
printf 'b\nc\nd\n' > s2
printf 'a\nb\nc\n' > sorted
printf 'a\nc\nb\n' > unsorted
printf 'a\na\nb\n' > sdup
: > empty
printf 'b\na' > nonl
printf '\n\n\n' > nls
printf 'a\0b\na\0a\n' > nul
printf '\377\nb\n\200\na\n' > bin
printf '\303\251\ne\n\303\211\nE\nz\n\303\250\n' > utf8
printf 'dash\nb\n' > ./-f
printf 'z\ny\n' > out_in
mkdir d

# the corpus in sort.in (see difftest.sh: CORPUS)
[ -d "${CORPUS-}" ] && cp "$CORPUS"/* .

# sorted halves for -m (long and many come from the corpus: a 70000-byte line, 3000 lines with equal keys)
awk 'BEGIN{for(i=0;i<1500;i++) printf "%06d a\n", i*2}' > sorted.even
awk 'BEGIN{for(i=0;i<1000;i++) printf "%06d b\n", i*3}' > sorted.three
awk 'BEGIN{for(i=0;i<1000;i++) printf "%06d c\n", i*3}' > sorted.three.c

# the lines of the SUSv4 EXAMPLES and APPLICATION USAGE
printf 'Atlanta|425022|Georgia\nBirmingham|284413|Alabama\nColumbia|100385|South Carolina\n' > cities
printf 'root:x:0:0:r:/root:/bin/sh\nbin:x:2:2:b:/bin:/bin/sh\ndaemon:x:1:1:d:/usr:/bin/sh\nnobody:x:65534:65534:n:/:/bin/sh\nmario:x:501:20:m:/home:/bin/zsh\n' > passwd
printf 'y\tb\nx a\n' > tabspace
printf 'one 1x\ntwo 2 \nthree\tx\nfour  y\n' > ex3
printf 'k1 a 9\nk2 b 8\nk1 c 7\nk3 d 6\nk2 e 5\n' > ex5
printf 'z b\ny a\n' > in1
printf 'x d\nw c\n' > in2
