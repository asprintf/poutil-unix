# a class in string2 other than a case conversion is a usage error here; macOS accepts it
'[:alpha:]' '[:upper:]'
'[:lower:]' '[:alpha:]'
# [:upper:] in string2 without [:lower:] in string1 is refused here; macOS accepts it
abc '[:upper:]'
# two [c*] in string2 are refused here (and by GNU); macOS accepts them
abc '[x*]y[z*]'
# [=e=]: macOS counts e, E and the accented forms as one class; ours asks the library's [[=e=]], which has the accented forms but not E
in:accents '[=e=]' '[e*]'
in:accents '[=e=]' x
in:accents -ds '[=e=]' x
# adjacent octal escapes that spell a multibyte character make that character here; macOS takes each byte alone
in:accents '\303\251' e
in:accents -d '\303\251'
in:emoji '\360\237\230\200' x
in:emoji x '\360\237\230\200'
# macOS refuses a byte that is no character in UTF-8; ours passes it through
in:bytes '\000-\037' '[.*]'
in:bytes '\101-\132' '\141-\172'
in:bytes '\200-\377' '[.*]'
in:bytes -d '\000-\177'
in:bytes -dc '\000-\177'
in:invalid '\377' x
in:invalid -c a x
in:invalid -cd a
in:invalid -d '\377'
in:invalid -s a
in:invalid a x
# a range that runs backwards is invalid here (and in GNU), the spec allows empty or invalid; macOS takes it as empty
z-a x
# a repeat count that does not fit in a number: macOS refuses it, here it means as many as string2 needs
in:text -c a '[x*18446744073709551615]'
# a repeat construct in string1 with a count too big for the characters of the locale is an error here; macOS takes it
'[x*18446744073709551615]' a
