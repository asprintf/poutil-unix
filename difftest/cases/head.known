# the obsolete -number form was dropped in POSIX.1-2001; both others still take it
-3 n5
# no -c in the spec ("there is no -c option"); both others have it
-c 3 n5
# the spec wants a positive decimal integer: no sign, no blank. GNU accepts a
# negative count (all but the last N lines) and "+1"; macOS and GNU accept a blank
-n -1 n5
-n +1 n5
-n ' 1' n5
# macOS rejects a count of 0 and one that does not fit; GNU and we take 0, and a
# huge count simply means "all of the file"
-n 0 n5
-n 99999999999999999999999 n5
# macOS head does not treat "-" as standard input; GNU puts quotes around
# names in the header, the spec says "%s"
-n 2 - n5
-n 2 -
-n 2 n5 -
-n 2 'a b' n5

# --- 2026-11-06 cases: every line below differs from both macOS and GNU
# - as a file operand: macOS does not take it for standard input; GNU quotes the name in the header
- -
- ten
-n 0 - -
-n 0 - ten
-n 0 ten - eleven
-n 1 - ten
-n 1 ten -
-n 100 - ten
-n 100 ten -
-n 3 - -
-n 3 -- - ten
-n 3 ten -
-n 3 ten - eleven
in:empty - -
in:empty - ten
in:empty -n 2 - empty
in:eol.none - ten
in:eol.none -n 2 - eleven -
in:eol.none -n 2 - empty
in:eol.none ten -
in:ten - -
in:ten -n 2 - eleven -
in:ten ten -
ten - eleven

# the obsolete -number form and long options: both others take them
--lines 2 ten
--lines=2 ten
-22 ten

# -c is not in the spec; both others have it
-c 3 ten
-c3 ten

# the spec wants a positive decimal integer: no sign, no blank; both others accept them
-n ' 1' ten
-n '+1' ten

# names with a blank in the header, and a count of 0: macOS rejects 0, GNU quotes the name
-n 0 'a b' ten
-n 0 'trailing ' ten
