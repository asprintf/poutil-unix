# posixutils-rs refuses a repeated option (clap: cannot be used multiple times); we, macOS and GNU accept it
-i -i A=1 /usr/bin/env
# the spec only says "arguments of the form name=value"; posixutils-rs takes a first word that is not a valid name as the utility (exit 127), we, macOS and GNU take it as an assignment
-i 'a b=c' /usr/bin/env
-i 1a=c /usr/bin/env
