# Bytes that are no character in UTF-8: undefined by the spec. macOS fails ("Illegal byte sequence") and counts what it could read; we count each byte as a character (GNU leaves them out).
-lwm all256
-lwm all256.lines
-lwm badtail
-lwm invalid.65536
-lwm invalid.after_emoji
-lwm invalid.cont
-lwm invalid.f8
-lwm invalid.ffff
-lwm invalid.in_emoji
-lwm invalid.lead_lead
-lwm invalid.overlong2
-lwm invalid.overlong3
-lwm invalid.surrogate
-lwm invalid.toobig
-lwm invalid.trunc3nl
-lwm invalid.trunc4
-lwm nulhigh
-m all256
-m all256.lines
-m badtail
-m invalid.65536
-m invalid.after_emoji
-m invalid.cont
-m invalid.f8
-m invalid.ffff
-m invalid.in_emoji
-m invalid.lead_lead
-m invalid.overlong2
-m invalid.overlong3
-m invalid.surrogate
-m invalid.toobig
-m invalid.trunc3nl
-m invalid.trunc4
-m nulhigh
in:all256 -lwm
in:all256 -m
in:all256.lines -lwm
in:all256.lines -m
in:invalid.after_emoji -lwm
in:invalid.after_emoji -m
in:invalid.cont -lwm
in:invalid.cont -m
in:invalid.f8 -lwm
in:invalid.f8 -m
in:invalid.ffff -lwm
in:invalid.ffff -m
in:invalid.in_emoji -lwm
in:invalid.in_emoji -m
in:invalid.lead_lead -lwm
in:invalid.lead_lead -m
in:invalid.overlong2 -lwm
in:invalid.overlong2 -m
in:invalid.overlong3 -lwm
in:invalid.overlong3 -m
in:invalid.surrogate -lwm
in:invalid.surrogate -m
in:invalid.toobig -lwm
in:invalid.toobig -m
in:invalid.trunc3nl -lwm
in:invalid.trunc3nl -m
in:invalid.trunc4 -lwm
in:invalid.trunc4 -m
# -w: the space class of LC_CTYPE decides (iswspace(), as in ours and GNU); macOS wc does not see U+2000..U+3000 as white space and counts other characters as white space.
-lwc all256
-lwc cjk.lines
-lwc emoji.tags
-lwc invalid.surrogate
-lwc mixed.scripts
-lwc noneol.cjk
-lwc space.1680
-lwc space.180e
-lwc space.2000
-lwc space.2001
-lwc space.2002
-lwc space.2003
-lwc space.2004
-lwc space.2005
-lwc space.2006
-lwc space.2007
-lwc space.2008
-lwc space.2009
-lwc space.200a
-lwc space.2028
-lwc space.2029
-lwc space.202f
-lwc space.205f
-lwc space.3000
-w all256
-w cjk.lines
-w emoji.basic emoji.zwj emoji.flags cjk.lines
-w emoji.tags
-w emsp2
-w invalid.surrogate
-w mixed.scripts
-w noneol.cjk
-w space.1680
-w space.180e
-w space.2000
-w space.2001
-w space.2002
-w space.2003
-w space.2004
-w space.2005
-w space.2006
-w space.2007
-w space.2008
-w space.2009
-w space.200a
-w space.2028
-w space.2029
-w space.202f
-w space.205f
-w space.3000
emsp2
# C locale: macOS writes ? for every byte of a name that is not ASCII, and stops after the first operand; we write the names as they are.
-c '😀 emoji.txt' 'ü ñ.txt' 日本語.txt
-lwm '😀 emoji.txt' 'ü ñ.txt' 日本語.txt
-m '😀 emoji.txt' 'ü ñ.txt' 日本語.txt
'😀 emoji.txt'
