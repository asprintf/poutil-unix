-hRL "$(id -u):$(id -G | cut -d' ' -f2)" 'l😀'
-hRL "$(id -u):$(id -G | cut -d' ' -f2)" dang
-hRL "$(id -u):$(id -G | cut -d' ' -f2)" dl
-hRL "$(id -u):$(id -G | cut -d' ' -f2)" f
