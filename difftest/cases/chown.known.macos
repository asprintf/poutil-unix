-hRL "$(id -u):$(id -G | cut -d' ' -f2)" tree sl dang f
-hRL "$(id -u):$(id -G | cut -d' ' -f2)" treelink
# -H, -L and -P belong to -R; alone they change nothing here (as GNU); macOS warns "only useful with -R", and for a dangling link it changes the link itself.
-H "$(id -u):$(id -G | cut -d' ' -f2)" 'l😀'
-H "$(id -u):$(id -G | cut -d' ' -f2)" dang
-H "$(id -u):$(id -G | cut -d' ' -f2)" dl
-H "$(id -u):$(id -G | cut -d' ' -f2)" f
