# GNU env puts new variables first (and macOS adds __CF_USER_TEXT_ENCODING); the order is unspecified
@
A=1
A=1 B=2
A=1 A=2
A=1 /usr/bin/env
# a name-less "=x" is an assignment to GNU, a utility name here and nowhere specified
=x printenv
# usage errors: any of 1-125 is allowed (ours 2, macOS 1, GNU 125)
-x
-i -x
